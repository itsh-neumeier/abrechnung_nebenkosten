# ---- Portainer-Stack ----
# Image-Tag: latest (Branch main) oder Branch-Name, z. B. claude-stromabrechnung-hausparteien-qif4vp
IMAGE_TAG=latest
# Port auf dem Docker-Host
APP_PORT=8000

# Home Assistant
HA_URL=https://homeassistant.example.de
# Langlebiges Zugriffstoken: HA -> Profil -> Sicherheit -> "Langlebige Zugriffstoken"
HA_TOKEN=

TZ=Europe/Berlin

# Optional: Zugangsschutz für das Webinterface (Basic Auth). Leer = kein Login.
APP_USER=admin
APP_PASSWORD=

# E-Mail-Versand der Abrechnungen (SMTP)
SMTP_HOST=
SMTP_PORT=587
# starttls | ssl | none
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Automatischer Abruf der Stromrechnungen aus dem Postfach (IMAP, nur lesend)
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
# Nur Mails von diesem Absender (Teilstring) werden geprüft
IMAP_SENDER=awattar.de
IMAP_INTERVAL_MIN=60
IMAP_SINCE_DAYS=40

# Optional: Basis-URL für Links in Hinweis-Mails
APP_BASE_URL=

# Optional: VRM (Victron-Cloud) als zusätzliche Datenquelle – persönlicher Zugriffstoken
VRM_TOKEN=

# Optional: WhatsApp direkt über die offizielle WhatsApp Business Cloud API (Meta)
# Zugriffstoken eines Systembenutzers, Telefonnummern-ID und App-Geheimnis (für den Status-Webhook)
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_APP_SECRET=
