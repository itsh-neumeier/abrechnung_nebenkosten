# Home Assistant
HA_URL=https://ha.neumeier.cloud
# Langlebiges Zugriffstoken: HA -> Profil -> Sicherheit -> "Langlebige Zugriffstoken"
HA_TOKEN=

TZ=Europe/Berlin

# Optional: Zugangsschutz für das Webinterface (Basic Auth). Leer = kein Login.
APP_USER=admin
APP_PASSWORD=

# E-Mail-Versand der Abrechnungen (SMTP)
SMTP_HOST=
SMTP_PORT=587
# starttls | ssl | none
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
