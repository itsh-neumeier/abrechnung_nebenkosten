# Home Assistant
HA_URL=https://homeassistant.example.de
# Langlebiges Zugriffstoken: HA -> Profil -> Sicherheit -> "Langlebige Zugriffstoken"
HA_TOKEN=

TZ=Europe/Berlin

# Erster Verwalter-Login (wird beim ersten Start angelegt; danach Benutzer im Webinterface verwalten).
# Leer = App bleibt offen, bis unter /setup ein Verwalter angelegt wird.
APP_USER=admin
APP_PASSWORD=
# optional: fester Schlüssel für Login-Cookies (sonst automatisch erzeugt)
APP_SECRET_KEY=
# optional: fester Schlüssel für Push-Benachrichtigungen (sonst automatisch erzeugt)
VAPID_PRIVATE_KEY=

# E-Mail-Versand der Abrechnungen (SMTP)
SMTP_HOST=
SMTP_PORT=587
# starttls | ssl | none
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
# Absender: Adresse des Postfachs aus SMTP_USER (oder ein Alias davon), optional mit Anzeigename, z. B.
# SMTP_FROM=Nebenkostenabrechnung <nebenkosten@example.de>
SMTP_FROM=

# Automatischer Abruf der Stromrechnungen aus dem Postfach (IMAP, nur lesend)
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
# Nur Mails von diesem Absender (Teilstring) werden geprüft
IMAP_SENDER=awattar.de
IMAP_INTERVAL_MIN=60
IMAP_SINCE_DAYS=40

# Optional: Basis-URL für Links in Hinweis-Mails
APP_BASE_URL=

# Optional: VRM (Victron-Cloud) als zusätzliche Datenquelle – persönlicher Zugriffstoken
VRM_TOKEN=

# Optional: WhatsApp direkt über die offizielle WhatsApp Business Cloud API (Meta)
# Zugriffstoken eines Systembenutzers, Telefonnummern-ID und App-Geheimnis (für den Status-Webhook)
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_APP_SECRET=
